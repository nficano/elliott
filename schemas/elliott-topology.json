{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://elliott.dev/schemas/topology.json",
  "title": "Elliott Connection Graph",
  "description": "Output shape of scripts/gen-topology.mjs and the hand-curated topology/elliott-topology.json: system components (nodes) and how they connect (edges).",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "version": { "type": "string" },
    "title": { "type": "string" },
    "generatedFrom": { "type": "string" },
    "note": { "type": "string" },
    "nodeKinds": { "type": "array", "items": { "type": "string" } },
    "edgeKinds": { "type": "array", "items": { "type": "string" } },
    "nodes": { "type": "array", "items": { "$ref": "#/definitions/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/definitions/edge" } }
  },
  "definitions": {
    "node": {
      "type": "object",
      "required": ["id", "kind", "domain"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "kind": {
          "enum": [
            "secret-source",
            "gateway",
            "runtime",
            "agent-loop",
            "provider",
            "tool",
            "service",
            "mcp-endpoint",
            "memory",
            "database",
            "learning",
            "evaluator",
            "observability",
            "container"
          ]
        },
        "runtime": {
          "enum": ["live", "config-gated", "dormant", "declared"],
          "description": "Liveness in the running runtime. The generator emits a static approximation (secret-gated => config-gated)."
        },
        "domain": { "type": "string" },
        "source": { "type": "string" },
        "classifications": { "type": "object" },
        "egressTargets": { "type": "array", "items": { "type": "string" } }
      }
    },
    "edge": {
      "type": "object",
      "required": ["from", "to", "kind"],
      "properties": {
        "id": { "type": "string" },
        "from": { "type": "string", "minLength": 1 },
        "to": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["data", "control", "persist", "learn", "health", "secret"]
        },
        "protocol": { "type": "string" },
        "label": { "type": "string" },
        "evidence": { "type": "string" }
      }
    }
  }
}
