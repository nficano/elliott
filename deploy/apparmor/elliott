#include <tunables/global>

profile elliott-kernel flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>
  network,
  deny mount,
  deny ptrace,
  /elliott/** r,
  /tmp/** rw,
}

profile elliott-audit flags=(attach_disconnected,mediate_deleted) {
