{
  "name": "elliott",
  "version": "0.1.0",
  "type": "module",
  "description": "Standalone TypeScript framework for composing secure personal AI agents from one universal primitive: the Component.",
  "license": "MIT",
  "bin": {
    "elliott": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./security": "./src/security/index.ts",
    "./manifest": "./src/manifest/index.ts",
    "./model": "./src/model/index.ts",
    "./providers": "./src/providers/index.ts",
    "./gateway": "./src/gateway/index.ts",
    "./mcp": "./src/mcp/index.ts",
    "./prompt": "./src/prompt/index.ts",
    "./memory": "./src/memory/index.ts",
    "./learning": "./src/learning/index.ts",
    "./scheduler": "./src/scheduler/index.ts",
    "./placement": "./src/placement/index.ts",
    "./audit": "./src/audit/index.ts",
    "./loop": "./src/loop/index.ts",
    "./observability": "./src/observability/index.ts",
    "./config": "./src/config/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./agent": "./src/agent/index.ts",
    "./hotcore": "./src/hotcore/index.ts",
    "./skills": "./src/runtime/skills/index.ts",
    "./runtime": "./src/runtime/types.ts",
    "./runtime/app": "./src/runtime/app.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "./scripts/prepare-effect.sh && ./scripts/setup-hooks.sh",
    "start": "bun src/runtime/main.ts",
    "dev": "ELLIOTT_ENV=dev bun src/runtime/main.ts",
    "footprint:check": "bun scripts/check-footprint.ts",
    "hot-core:build": "bun scripts/build-hot-core.ts",
    "hot-core:check": "cargo test --manifest-path native/hot-core/Cargo.toml && bun run hot-core:build && bun scripts/check-hot-core.ts && bun test test/fuzz/hot-core-fuzz.test.ts",
    "ratchet:check": "bun scripts/ratchet-guard.ts",
    "unicode:check": "bun scripts/check-unicode-safety.ts",
    "workflows:check": "bun scripts/check-workflow-security.ts",
    "darwin:check": "./scripts/check-darwin.sh",
    "darwin:build": "./scripts/build-darwin.sh",
    "darwin:smoke": "./scripts/smoke-darwin.sh",
    "evolution:acceptance": "bun scripts/audit-evolution-acceptance.ts",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun test && bun run darwin:check && bun run footprint:check && bun run hot-core:check && bun run unicode:check && bun run workflows:check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "test": "bun test",
    "test:coverage": "bun scripts/coverage-gate.ts"
  },
  "dependencies": {
    "effect": "4.0.0-beta.100",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@effect/eslint-plugin": "^0.3.2",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.1.14",
    "ajv": "^8.20.0",
    "dprint": "^0.55.2",
    "eslint": "^10.7.0",
    "eslint-plugin-better-max-params": "^1.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
