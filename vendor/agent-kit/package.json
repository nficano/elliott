{
  "name": "agent-kit",
  "version": "0.0.0",
  "type": "module",
  "description": "Reusable personal-agent framework. Clean-room, no OpenClaw, no @tmh/*.",
  "exports": {
    ".": "./src/index.ts",
    "./core": "./src/core/index.ts",
    "./host": "./src/host/index.ts",
    "./spec": "./src/host/spec/index.ts",
    "./store": "./src/store/index.ts",
    "./channels": "./src/channels/index.ts",
    "./skills/web": "./src/skills/web/index.ts",
    "./skills/watch": "./src/skills/watch/index.ts",
    "./skills/ops": "./src/skills/ops/index.ts",
    "./skills/email": "./src/skills/email/index.ts",
    "./skills/github": "./src/skills/github/index.ts",
    "./skills/reminders": "./src/skills/reminders/index.ts",
    "./plugins": "./src/plugins/index.ts",
    "./integrations": "./src/integrations/index.ts",
    "./testkit": "./src/testkit/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "test": "bun test",
    "footprint-gate": "bun run src/testkit/footprint-gate.ts",
    "migrate": "bun run src/store/migrate.ts"
  },
  "dependencies": {
    "@effect/opentelemetry": "^4.0.0-beta.100",
    "@effect/sql-pg": "^4.0.0-beta.100",
    "@googleapis/gmail": "^17.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/exporter-metrics-otlp-http": "0.221.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/resources": "2.10.0",
    "@opentelemetry/sdk-metrics": "2.10.0",
    "@opentelemetry/sdk-trace-base": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@opentelemetry/semantic-conventions": "^1.42.0",
    "@slack/web-api": "^8.0.0",
    "@slack/webhook": "^8.0.0",
    "croner": "^9.0.0",
    "effect": "^4.0.0-beta.100",
    "gpt-tokenizer": "^2.8.1",
    "hono": "^4.6.14",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@effect/eslint-plugin": "^0.3.2",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.1.14",
    "dprint": "^0.55.2",
    "eslint": "^10.7.0",
    "eslint-plugin-better-max-params": "^1.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0"
  }
}
